AEGIS_DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5433/aegis
AEGIS_OPENAI_BASE_URL=https://api.openai.com/v1
AEGIS_EMBEDDING_MODEL=text-embedding-3-small
AEGIS_OPENAI_MODEL=gpt-5.6-luna
AEGIS_AGENT_EFFORT=high
AEGIS_AGENT_MAX_TURNS=20
AEGIS_SLACK_WEBHOOK_URL=
AEGIS_GITHUB_WEBHOOK_SECRET=
AEGIS_CORPUS_DIR=corpus

# OPENAI_API_KEY is intentionally unprefixed for compatibility with other
# tools that read this name directly. This local .env file is gitignored; fill
# in the real key here rather than committing it.
OPENAI_API_KEY=

# The compose file publishes PostgreSQL on 5433. To run the integration
# suite against a local Homebrew PostgreSQL instead of Docker:
#   createuser aegis --login && createdb -O aegis aegis
#   psql -d aegis -c 'CREATE EXTENSION IF NOT EXISTS vector'
#   AEGIS_DATABASE_URL=postgresql+psycopg://aegis:aegis@127.0.0.1:5432/aegis uv run pytest -q

# make demo-live only: the tunnelled GitHub live-push observation (docs §6).
# GITHUB_REPO=owner/scratch-repo
# PUBLIC_BASE_URL=https://the-tunnel.example
# AEGIS_LIVE_DEMO_TIMEOUT_SECONDS=300
